# BabyVibes: security and https for the shop folder (Apache / LiteSpeed on cPanel).
Options -Indexes

<IfModule mod_rewrite.c>
	RewriteEngine On
	# Always use https (skipped when a proxy in front of the server already handles it).
	RewriteCond %{HTTPS} off
	RewriteCond %{HTTP:X-Forwarded-Proto} !https
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
	# Folders and files that are never meant for visitors, even if uploaded by mistake.
	RewriteRule ^(tests|tools|\.git)(/|$) - [F,L]
</IfModule>

<FilesMatch "(^\.(ht|git|cpanel)|\.md$|\.yml$|\.json\.bak$|\.log$|\.db$|\.sql$)">
	Require all denied
</FilesMatch>

<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Let browsers cache images, styles and scripts for a week (the HTML is never cached long).
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType image/jpeg "access plus 7 days"
	ExpiresByType image/png "access plus 7 days"
	ExpiresByType image/svg+xml "access plus 7 days"
	ExpiresByType text/css "access plus 7 days"
	ExpiresByType application/javascript "access plus 7 days"
	ExpiresByType text/html "access plus 0 seconds"
	ExpiresByType application/json "access plus 0 seconds"
</IfModule>
